{
  "name": "orbitx",
  "private": true,
  "version": "0.0.0",
  "description": "Digital Media Asset Management for campaign assets, captions, and publishing schedules",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "clean": "rm -rf dist .wrangler",
    "types": "wrangler types",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "validate": "bash scripts/validate.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dompurify": "^3.4.8",
    "express": "^4.21.2",
    "express-validator": "^7.3.2",
    "fflate": "^0.8.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "marked": "^18.0.4",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "uuid": "^14.0.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.1",
    "wrangler": "^4.131.2"
  },
  "overrides": {
    "iconv-lite": "^0.6.3"
  }
}
