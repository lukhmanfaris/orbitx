{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbitx",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "orbitx.my", "custom_domain": true },
    { "pattern": "www.orbitx.my", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "r2_buckets": [
    { "binding": "R2_BUCKET", "bucket_name": "orbitx", "remote": true }
  ],
  "ratelimits": [
    { "name": "API_LIMITER",    "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } },
    { "name": "LOGIN_LIMITER",  "namespace_id": "1002", "simple": { "limit": 5,   "period": 60 } },
    { "name": "UPLOAD_LIMITER", "namespace_id": "1003", "simple": { "limit": 10,  "period": 60 } }
  ],
  "vars": {
    "R2_PUBLIC_URL": "https://pub-7436bc7b7bf84920b3700d43b34b5737.r2.dev",
    "SUPABASE_URL": "https://tjxejnkjcidyfqprynhz.supabase.co"
  },
  "observability": { "enabled": true }
}
